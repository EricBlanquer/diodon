#: ../data/preferences.ui.h:16 ../unity-scope-diodon/unity-scope-diodon.vala:75
msgid "Clipboard"
msgstr "Schowek"

#: ../data/preferences.ui.h:17
msgid ""
"Please register custom shortcut with\n"
"your desktop environment.\n"
"Use /usr/bin/diodon as command."
msgstr ""
"Zarejestruj niestandardowy skrót za pomocą\n"
"środowiska pulpitu.\n"
"Użyj /usr/bin/diodon jako polecenia"

#: ../data/preferences.ui.h:20
msgid "More information"
msgstr "Więcej informacji"

#: ../data/preferences.ui.h:21
msgid "Hotkeys"
msgstr "Skróty klawiszowe"

#: ../data/preferences.ui.h:22
msgid "Plugins"
